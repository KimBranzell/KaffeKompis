---
import navigationItems from '../../data/menuItems.js';
const path = Astro.url.pathname;
---
<site-navigation>
  <button class="menu-toggle" type="button" hidden aria-expanded="false" aria-controls="primary-navigation">Meny</button>
  <nav id="primary-navigation" aria-label="Huvudmeny">
    <ul class="nav-list">
      {navigationItems.map(item => (
        <li>
          {item.subItems ? (
            <details>
              <summary>{item.label}</summary>
              <ul class="tool-links">
                {item.subItems.map(subItem => (
                  <li><a href={subItem.href} aria-current={path === subItem.href ? 'page' : undefined}>{subItem.label}</a></li>
                ))}
              </ul>
            </details>
          ) : (
            <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a>
          )}
        </li>
      ))}
    </ul>
  </nav>
</site-navigation>

<script>
  class SiteNavigation extends HTMLElement {
    connectedCallback() {
      const toggle = this.querySelector<HTMLButtonElement>('.menu-toggle')!;
      const nav = this.querySelector<HTMLElement>('nav')!;
      const desktop = window.matchMedia('(min-width: 1000px)');
      const close = () => {
        this.dataset.collapsed = 'true';
        toggle.setAttribute('aria-expanded', 'false');
        this.querySelectorAll('details').forEach(details => details.open = false);
      };
      toggle.hidden = false;
      close();
      toggle.addEventListener('click', () => {
        const expanded = toggle.getAttribute('aria-expanded') !== 'true';
        this.dataset.collapsed = String(!expanded);
        toggle.setAttribute('aria-expanded', String(expanded));
      });
      this.addEventListener('keydown', event => {
        if (event.key !== 'Escape') return;
        const openDetails = this.querySelector('details[open]');
        if (openDetails) {
          openDetails.removeAttribute('open');
          openDetails.querySelector('summary')?.focus();
        } else {
          close();
          toggle.focus();
        }
      });
      nav.addEventListener('click', event => { if ((event.target as HTMLElement).closest('a')) close(); });
      const outside = (event: Event) => { if (!this.contains(event.target as Node)) close(); };
      const resize = () => { close(); if (desktop.matches && this.contains(document.activeElement) && document.activeElement === toggle) nav.querySelector('a')?.focus(); };
      document.addEventListener('click', outside);
      desktop.addEventListener('change', resize);
      this.cleanup = () => { document.removeEventListener('click', outside); desktop.removeEventListener('change', resize); };
    }
    cleanup?: () => void;
    disconnectedCallback() { this.cleanup?.(); }
  }
  if (!customElements.get('site-navigation')) customElements.define('site-navigation', SiteNavigation);
</script>

<style>
  site-navigation { margin-left: auto; }
  button, summary, a { min-height: 44px; padding: .6rem .8rem; border-radius: 4px; font-weight: 800; }
  button { border: 2px solid currentColor; background: #fd9745; color: #111; }
  a { display: block; }
  a:hover, a[aria-current="page"], summary:hover { text-decoration: underline; text-underline-offset: .25em; }
  summary { cursor: pointer; }
  .nav-list { display: flex; align-items: center; gap: .25rem; }
  details { position: relative; }
  .tool-links { position: absolute; right: 0; top: 100%; width: 290px; border: 2px solid #111; padding: .5rem; background: var(--surface); box-shadow: 4px 4px 0 #111; }
  .menu-toggle { display: none; }
  @media (max-width: 999px) {
    .menu-toggle:not([hidden]) { display: block; }
    site-navigation[data-collapsed="true"] nav { display: none; }
    nav { position: absolute; top: 100%; left: 0; width: 100%; max-height: calc(100dvh - var(--header-height)); overflow-y: auto; background: var(--surface); border-bottom: 3px solid #111; padding: .75rem 1rem; }
    .nav-list { display: grid; gap: .25rem; }
    .tool-links { position: static; width: auto; margin: .25rem 0 .5rem; box-shadow: none; border-width: 0 0 0 3px; }
  }
</style>
