
---
import { METHOD_LABELS, METHOD_COLORS } from '../../lib/recipes/methods.js';
import { formatGrams } from '../../lib/recipes/brewing.js';
const { headingLevel = 3, dose, ratioLabel, title, method, difficulty, time, slug, link, description } = Astro.props;
const Heading = headingLevel === 2 ? 'h2' : 'h3';
const href = link ?? `/recept/${slug}/`;

const methodColors = METHOD_COLORS;
const methodLabels = METHOD_LABELS;
---

<article class="flex h-full flex-col justify-between border-3 border-black paper-surface p-6 shadow-[6px_6px_0_#000]">
  <div class="space-y-4">
    <div class="accent-panel flex flex-wrap gap-2 text-sm font-black uppercase tracking-[0.12em]">
      <span class={`${methodColors[method]} border-2 border-black px-3 py-1`}>
        {methodLabels[method]}
      </span>
      <span class="border-2 border-black bg-[#f2f2f2] px-3 py-1">
        {time}
      </span>
      <span class="border-2 border-black bg-[#fff7ed] px-3 py-1">
        {difficulty}
      </span>
    </div>

    <div class="space-y-3">
      <Heading class="text-2xl font-black leading-tight">{title}</Heading>
      {dose && <p class="font-bold text-foreground/80">{formatGrams(dose)} g kaffe · {ratioLabel} · justerbar dos</p>}
      {description && <p class="text-base leading-7 text-foreground/80">{description}</p>}
    </div>
  </div>

  <a href={href} class="mt-6 inline-flex w-fit border-3 border-black bg-black px-4 py-3 text-sm font-black uppercase tracking-[0.16em] text-white transition-transform hover:-translate-y-1">
    Se recept
  </a>
</article>
