---
export interface Props {
  featuredRecipe?: { title: string; description: string; href: string; time: string; dose?: number; water?: number };
}
const { featuredRecipe } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<section class="accent-panel relative overflow-hidden border-b-3 border-black bg-[linear-gradient(135deg,#fff7ed_0%,#ffe7ba_52%,#ffd166_100%)]">
  <div class="relative mx-auto grid w-full max-w-7xl gap-10 px-4 py-12 lg:grid-cols-[1.15fr_0.85fr] lg:items-center lg:py-20">
    <div class="space-y-7">
      <p class="inline-flex border-3 border-black bg-white px-4 py-2 text-sm font-black uppercase tracking-[0.16em] shadow-[4px_4px_0_#000]">Kaffekompis · din bryggarvän</p>
      <h1 class="max-w-4xl text-5xl font-black leading-none md:text-6xl lg:text-7xl">Ett bra kaffe börjar med ett tydligt recept.</h1>
      <p class="max-w-2xl text-lg leading-8 text-black/80 md:text-xl">Välj en bryggmetod, ställ in mängden och följ stegen. Här samlas recepten och kunskapen som hjälper dig att hitta din kopp.</p>
      <div class="flex flex-col gap-4 sm:flex-row">
        <a href={`${base}recept/`} class="inline-flex min-h-12 items-center justify-center border-3 border-black bg-black px-6 py-4 font-black text-white shadow-[5px_5px_0_#000]">Hitta ett bryggrecept</a>
        <a href={`${base}verktyg/`} class="inline-flex min-h-12 items-center justify-center border-3 border-black bg-white px-6 py-4 font-black text-black">Utforska verktygen</a>
      </div>
    </div>
    {featuredRecipe && <div class="border-3 border-black bg-[#111111] p-6 text-[#fff8e8] shadow-[7px_7px_0_#000] md:p-8">
      <p class="text-sm font-black uppercase tracking-[0.16em] text-[#ffd166]">Börja här</p>
      <h2 class="mt-4 text-3xl font-black leading-tight">{featuredRecipe.title}</h2>
      <p class="mt-4 text-base leading-7">{featuredRecipe.description}</p>
      <dl class="mt-6 grid grid-cols-3 gap-3 border-y-2 border-dashed border-[#ffd166] py-5">
        <div><dt class="text-xs font-bold uppercase tracking-wider">Kaffe</dt><dd class="mt-2 text-xl font-black">{featuredRecipe.dose} g</dd></div>
        <div><dt class="text-xs font-bold uppercase tracking-wider">Vatten</dt><dd class="mt-2 text-xl font-black">{featuredRecipe.water} g</dd></div>
        <div><dt class="text-xs font-bold uppercase tracking-wider">Tid</dt><dd class="mt-2 text-base font-black">{featuredRecipe.time}</dd></div>
      </dl>
      <a href={featuredRecipe.href} class="mt-6 inline-flex min-h-12 items-center border-3 border-[#ffd166] px-5 py-3 font-black text-[#ffd166]">Anpassa och brygg</a>
    </div>}
  </div>
</section>
