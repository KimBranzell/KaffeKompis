---
import { getCollection } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import Hero from '../components/Hero/Hero.astro';
import ToolCard from '../components/Cards/ToolCard.astro';
import BlogCard from '../components/Cards/BlogCard.astro';
import RecipeCard from '../components/Cards/RecipeCard.astro';
import { recipeTimeLabel } from '../lib/recipes/brewing.js';

const base = import.meta.env.BASE_URL;
const dateFormat = new Intl.DateTimeFormat('sv-SE', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/Stockholm' });
const recipes = (await getCollection('recipes')).sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || a.data.title.localeCompare(b.data.title, 'sv'));
const tools = (await getCollection('tools')).sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || a.data.title.localeCompare(b.data.title, 'sv'));
const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const firstRecipe = recipes.find(recipe => recipe.data.brew);
const featuredRecipe = firstRecipe ? {
  title: firstRecipe.data.title, description: firstRecipe.data.description,
  href: `${base}recept/${firstRecipe.id}/`, time: recipeTimeLabel(firstRecipe.data),
  dose: firstRecipe.data.brew!.coffeeGrams,
  water: firstRecipe.data.brew!.coffeeGrams * firstRecipe.data.brew!.ratio,
} : undefined;
---
<PageLayout title="Hem" description="Bryggrecept, guidat bryggläge och kaffekunskap för en god kopp hemma. Börja med din bryggmetod och anpassa mängden.">
  <Hero {featuredRecipe} />
  <div class="mx-auto flex w-full max-w-7xl flex-col gap-16 px-4 py-12 md:py-16">
    <section aria-labelledby="home-recipes-title" class="space-y-7">
      <div class="max-w-3xl space-y-3"><p class="section-kicker">Bryggrecept</p><h2 id="home-recipes-title" class="section-title">Vad brygger du med?</h2><p class="section-copy">Hitta ett grundrecept som passar din bryggare. V60-receptet hjälper dig att anpassa dosen och följa hällningarna steg för steg.</p></div>
      <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">{recipes.map(recipe => <RecipeCard title={recipe.data.title} method={recipe.data.method} difficulty={recipe.data.difficulty} time={recipeTimeLabel(recipe.data)} dose={recipe.data.brew?.coffeeGrams} ratio={recipe.data.brew?.ratio} slug={recipe.id} link={`${base}recept/${recipe.id}/`} description={recipe.data.description} />)}</div>
    </section>
    <section aria-labelledby="home-tools-title" class="space-y-7">
      <div class="max-w-3xl space-y-3"><p class="section-kicker">Vid sidan av bryggaren</p><h2 id="home-tools-title" class="section-title">Verktyg för nästa justering.</h2><p class="section-copy">Räkna på vattenmängden, prova 4:6-metoden eller felsök en kopp som inte blev som du tänkt.</p></div>
      <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">{tools.map(tool => <ToolCard title={tool.data.title} description={tool.data.description} icon={tool.data.icon} link={tool.data.href ? `${base}${tool.data.href.replace(/^\//, '')}` : undefined} status={tool.data.status} badge={tool.data.badge} />)}</div>
    </section>
    <section aria-labelledby="home-guides-title" class="space-y-7">
      <div class="max-w-3xl space-y-3"><p class="section-kicker">Kaffekunskap</p><h2 id="home-guides-title" class="section-title">Förstå vad som händer i koppen.</h2><p class="section-copy">Läs om rostning, malning och utrustning och använd kunskapen i nästa bryggning.</p></div>
      <div class="grid gap-6 md:grid-cols-2">{posts.filter(post => post.id !== 'valkommen').slice(0, 2).map(post => <BlogCard title={post.data.title} date={dateFormat.format(post.data.pubDate)} slug={post.id} link={`${base}blogg/${post.id}/`} description={post.data.description} tags={post.data.tags} />)}</div>
      <a href={`${base}blogg/`} class="inline-flex min-h-12 items-center font-bold underline underline-offset-4">Se alla guider och inlägg</a>
    </section>
  </div>
</PageLayout>
